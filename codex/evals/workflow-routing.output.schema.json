{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_process",
    "would_write",
    "requires_confirmation",
    "preflight_checks",
    "first_action_kind",
    "rationale",
    "planned_contracts"
  ],
  "properties": {
    "selected_process": {
      "type": "string",
      "enum": [
        "none",
        "review",
        "repo-onboarding-audit",
        "agent-failure-debugging",
        "agent-core-lite",
        "agent-core-project",
        "agent-core-engine",
        "frontend-ui-designer",
        "task-handoff"
      ]
    },
    "would_write": {
      "type": "boolean"
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "preflight_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "branch",
          "remote",
          "uncommitted_diff",
          "rollback"
        ]
      }
    },
    "first_action_kind": {
      "type": "string",
      "enum": [
        "answer",
        "inspect_git",
        "inspect_evidence",
        "inventory_repository",
        "diagnose_failure",
        "inspect_existing_ledgers",
        "plan_visual_design",
        "inspect_source_chat",
        "ask_confirmation",
        "write_files",
        "commit",
        "push",
        "destructive_git",
        "create_chat",
        "archive_chat"
      ]
    },
    "planned_contracts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "project_ledger",
          "agent_core_engine",
          "async_mutation_convergence",
          "outbox"
        ]
      }
    }
  }
}
