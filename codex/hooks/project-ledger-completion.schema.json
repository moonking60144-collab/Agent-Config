{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex project ledger completion contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerPath", "findings", "requiredEvidence", "preflights"],
  "properties": {
    "schemaVersion": { "enum": [1, 2, 3] },
    "evidencePolicyVersion": { "const": 1 },
    "ledgerPath": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "blockingCompletion", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "status": { "enum": ["open", "resolved", "accepted_risk", "deferred", "out_of_scope", "blocked_external"] },
          "blockingCompletion": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "requiredEvidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["missing", "present", "waived"] },
          "claim": { "type": "string", "minLength": 1 },
          "claimScope": { "enum": ["local", "cross-boundary", "review"] },
          "evidenceClass": { "enum": ["helper", "unit", "composed", "runtime", "production", "independent-review"] },
          "artifact": { "type": "string", "minLength": 1 },
          "artifactBase": { "enum": ["repo", "contract"] },
          "artifactSha256": { "type": "string", "minLength": 64 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "preflights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["local", "cross-boundary"] },
          "status": { "enum": ["open", "resolved", "not_applicable", "waived"] },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "remoteChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "status", "checks"],
      "properties": {
        "applicable": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 40 },
        "policySource": { "type": "string", "minLength": 1 },
        "policyFingerprint": { "type": "string", "minLength": 64 },
        "status": { "enum": ["not_applicable", "pending", "passed", "failed", "unknown"] },
        "checkedAt": { "type": "string", "minLength": 1 },
        "evidenceUrl": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "status": { "enum": ["pending", "passed", "failed", "unknown"] },
              "evidenceUrl": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
