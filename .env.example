# MCP Server Environment Variables
# 複製此檔案為 .env 並填入您的實際 API Keys

# GitHub Personal Access Token (GitHub 整合)
# 申請連結: https://github.com/settings/tokens
# 需要權限: repo, read:org, user:email
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE

# Firecrawl API Key (網頁抓取/爬行/抽取)
# 申請連結: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE

# 專案路徑（用於 Serena MCP）
# 範例：C:/Users/YOUR_USERNAME/Desktop/YOUR_PROJECT
# 注意：使用正斜線 (/)，非反斜線 (\)
PROJECT_PATH=YOUR_PROJECT_PATH_HERE

# 注意事項:
# 1. 請勿將 .env 檔案提交到 Git (已在 .gitignore 中排除)
# 2. API Keys 請妥善保管，不要分享給他人
# 3. 如果某個服務不使用，可以保留預設值或留空
# 4. config.toml 中的路徑和 API keys 請參照此範本填入
