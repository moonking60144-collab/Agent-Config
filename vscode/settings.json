{
  "chat.mcp.gallery.enabled": true,
  "explorer.confirmDelete": false,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "claudeCode.selectedModel": "default",
  "claudeCode.preferredLocation": "panel",
  "chatgpt.runCodexInWindowsSubsystemForLinux": false,
  "chatgpt.localeOverride": null,
  "chatgpt.cliExecutable": "",
  "commit-message-editor.staticTemplate": [
    "feat: Short description",
    "",
    "Message body",
    "",
    "Message footer",
    "如果有程式碼修改建議，請同樣用繁體中文解釋原因，再給出修改後的程式碼。",
    "請一律使用「繁體中文」回答以下內容，說明時盡量條列式、簡潔清楚。  以下是我要你處理的內容：",
    "Explain in zh-TW"
  ],
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "gitlens.views.commitDetails.files.layout": "list",
  "git-log--graph.position": "view",
  "continue.enableConsole": true,
  "codeium.enableCodeLens": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "pieces.OS.launchOnStartup": "Yes",
  "pieces.OS.autoLaunchOnInteraction": true,
  "chat.mcp.discovery.enabled": {
    "windsurf": true,
    "claude-desktop": true
  },
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "git.path": "C:\\Program Files\\Git\\cmd\\git.exe",
  "mcp.git.useSystemGit": true,
  "mcp.git.disableRemoteDiff": true,
  "mcp.git.enabled": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "editor.wordWrap": "on",
  "sqltools.useNodeRuntime": true,
  "workbench.secondarySideBar.showLabels": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.tabActionLocation": "left",
  "workbench.editor.openPositioning": "left",
  "window.restoreWindows": "all",
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.fontFamily": "JetBrainsMono NFM, JetBrainsMono Nerd Font Mono, monospace",
  "editor.fontFamily": "JetBrainsMono NF, JetBrainsMono Nerd Font, Cascadia Code, Consolas, 'Courier New', monospace",
  "redhat.telemetry.enabled": true,
  "remote.otherPortsAttributes": {
    "onAutoForward": "openBrowser"
  },
  "workbench.browser.openLocalhostLinks": false
}
