{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "effortLevel": "xhigh",
  "switchModelsOnFlag": true,
  "skipDangerousModePermissionPrompt": true,
  "autoMemoryEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_STOP_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "檢查繁體中文"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_COMPLETION_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "檢查專案完成證據"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_PROVENANCE_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "記錄工作流來源"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_RESUME_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "續接專案 ledger"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_HANDOFF_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "續接交接內容"
          }
        ]
      }
    ]
  }
}
