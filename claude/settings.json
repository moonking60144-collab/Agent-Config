{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "effortLevel": "xhigh",
  "switchModelsOnFlag": true,
  "skipDangerousModePermissionPrompt": true,
  "autoMemoryEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_STOP_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "檢查繁體中文"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "__CLAUDE_EVIDENCE_HOOK_PATH__"
            ],
            "timeout": 20,
            "statusMessage": "檢查結論依據"
          }
        ]
      }
    ]
  }
}
