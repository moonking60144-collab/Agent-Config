#!/bin/sh
# Deterministic repo checks only: no model calls, and --skip-active keeps machine-specific state out of the gate.
set -e
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR and related variables to hooks; tests that create their own repos must not inherit them.
unset $(git rev-parse --local-env-vars)
node --test tests/*.test.mjs
node scripts/validate-codex.mjs --skip-active
if command -v python3 >/dev/null 2>&1; then python3 tests/ui-ux-pro-max.test.py; else python tests/ui-ux-pro-max.test.py; fi
